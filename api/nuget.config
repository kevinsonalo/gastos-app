<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuentes de paquetes SOLO para este repositorio: ignora las fuentes privadas de la
  configuración global de la máquina (p. ej. feeds corporativos que piden credenciales).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
